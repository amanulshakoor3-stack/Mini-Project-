    replacement_chunks {
      replacement_content: "import { AnimalSpecies } from \"../types\";\n\nexport const SUPPORTED_ANIMALS: AnimalSpecies[] = [\n  {\n    id: \"dog\",\n    name: \"Dog\",\n    scientificName: \"Canis lupus familiaris\",\n    icon: \"\360\237\220\225\",\n    category: \"Mammal\",\n    diet: \"Omnivore\",\n    habitat: \"Domestic / Global\",\n    description: \"Domesticated descendant of the wolf, known for diverse breeds, keen olfaction, and social intelligence.\",\n    keyFeatures: [\"Muzzle with prominent rhinarium\", \"Variable erect or dropped ears\", \"Digitigrade posture with non-retractile claws\"],\n    sampleImage: \"https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"cat\",\n    name: \"Cat\",\n    scientificName: \"Felis catus\",\n    icon: \"\360\237\220\210\",\n    category: \"Carnivoran\",\n    diet: \"Obligate Carnivore\",\n    habitat: \"Domestic / Global\",\n    description: \"Small, carnivorous mammal with acute senses, retractable claws, and exceptional agility.\",\n    keyFeatures: [\"Vertical slit pupils\", \"Triangular pinned ears\", \"Flexible spine and retractable claws\"],\n    sampleImage: \"https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"lion\",\n    name: \"Lion\",\n    scientificName: \"Panthera leo\",\n    icon: \"\360\237\246\201\",\n    category: \"Carnivoran\",\n    diet: \"Carnivore (Hypercarnivore)\",\n    habitat: \"Savannahs, Grasslands & Dense Scrub\",\n    description: \"Known as the \'King of the Jungle\', lions are large felids displaying marked sexual dimorphism and social pride structures.\",\n    keyFeatures: [\"Voluminous cranial mane (males)\", \"Muscular compact feline build\", \"Tawny yellow-gold coat with tufted tail\"],\n    sampleImage: \"https://images.unsplash.com/photo-1614027164847-1b28cfe1df60?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"tiger\",\n    name: \"Tiger\",\n    scientificName: \"Panthera tigris\",\n    icon: \"\360\237\220\205\",\n    category: \"Carnivoran\",\n    diet: \"Carnivore (Apex Predator)\",\n    habitat: \"Tropical Rainforests, Mangroves & Taiga\",\n    description: \"The largest living cat species, immediately recognized by its reddish-orange coat with distinctive dark vertical stripes.\",\n    keyFeatures: [\"Distinct vertical black camouflage stripes\", \"White eye patches and facial ruff\", \"Heavily muscled forequarters\"],\n    sampleImage: \"https://images.unsplash.com/photo-1561731216-c3a4d99437d5?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"elephant\",\n    name: \"Elephant\",\n    scientificName: \"Loxodonta africana / Elephas maximus\",\n    icon: \"\360\237\220\230\",\n    category: \"Mammal\",\n    diet: \"Herbivore (Megaherbivore)\",\n    habitat: \"Savannahs, Dense Forests & Marshes\",\n    description: \"The largest existing terrestrial animals, characterized by long prehensile trunks, ivory tusks, and broad fan-shaped ears.\",\n    keyFeatures: [\"Prehensile muscular proboscis (trunk)\", \"Elongated ivory incisors (tusks)\", \"Columnar pillar-like limbs and thick wrinkled dermis\"],\n    sampleImage: \"https://images.unsplash.com/photo-1557050543-4d5f4e07ef46?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"horse\",\n    name: \"Horse\",\n    scientificName: \"Equus caballus\",\n    icon: \"\360\237\220\216\",\n    category: \"Ungulate\",\n    diet: \"Herbivore\",\n    habitat: \"Pastures, Steppes & Grasslands\",\n    description: \"Odd-toed ungulate mammal adapted to swift travel across open terrain, with high endurance and deep social bonds.\",\n    keyFeatures: [\"Elongated head with prominent flowing mane\", \"Single solid keratin hoof per leg\", \"High-positioned lateral eyes\"],\n    sampleImage: \"https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"cow\",\n    name: \"Cow\",\n    scientificName: \"Bos taurus\",\n    icon: \"\360\237\220\204\",\n    category: \"Ungulate\",\n    diet: \"Herbivore (Ruminant)\",\n    habitat: \"Pastures, Meadows & Agricultural Lands\",\n    description: \"Large domesticated ungulates with four-chambered stomachs engineered for fermenting high-fiber vegetation and grazing.\",\n    keyFeatures: [\"Broad moist muzzle and cloven hooves\", \"Stout barrel-like torso\", \"Distinctive pied or solid pigmentation\"],\n    sampleImage: \"https://images.unsplash.com/photo-1570042225831-d98fa7577f1e?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"deer\",\n    name: \"Deer\",\n    scientificName: \"Cervidae\",\n    icon: \"\360\237\246\214\",\n    category: \"Ungulate\",\n    diet: \"Herbivore (Browser/Grazer)\",\n    habitat: \"Temperate Deciduous Forests & Mountain Meadows\",\n    description: \"Hoofed ruminants characterized by slender legs, keen vigilance, and bone antlers shed and regrown annually by males.\",\n    keyFeatures: [\"Branching deciduous bone antlers\", \"Slender athletic limbs for leaping\", \"White rump/tail warning markings\"],\n    sampleImage: \"https://images.unsplash.com/photo-1484406566174-9da000fda645?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"bear\",\n    name: \"Bear\",\n    scientificName: \"Ursidae\",\n    icon: \"\360\237\220\273\",\n    category: \"Carnivoran\",\n    diet: \"Omnivore / Opportunistic Carnivore\",\n    habitat: \"Boreal Forests, Alpine Tundra & River Basins\",\n    description: \"Large, heavily built mammals with massive paws, long non-retractile claws, thick coarse fur, and exceptional sense of smell.\",\n    keyFeatures: [\"Massive shoulder muscle hump\", \"Heavy plantigrade feet with non-retractable curved claws\", \"Short rounded ears and dense shaggy coat\"],\n    sampleImage: \"https://images.unsplash.com/photo-1530595467537-0b5996c41f2d?auto=format&fit=crop&w=600&q=80\",\n  },\n  {\n    id: \"monkey\",\n    name: \"Monkey\",\n    scientificName: \"Simiiformes\",\n    icon: \"\360\237\220\222\",\n    category: \"Primate\",\n    diet: \"Omnivore / Frugivore\",\n    habitat: \"Tropical Rainforest Canopies & Montane Woodlands\",\n    description: \"Intelligent, dexterous primates with forward-facing stereoscopic eyes, prehensile hands/feet, and dynamic arboreal adaptations.\",\n    keyFeatures: [\"Opposable thumbs and flexible digits\", \"Expressive facial musculature\", \"Prehensile or stabilizing tail\"],\n    sampleImage: \"https://images.unsplash.com/photo-1540573133985-87b6da6d54a9?auto=format&fit=crop&w=600&q=80\",\n  },\n];\n"
    }
